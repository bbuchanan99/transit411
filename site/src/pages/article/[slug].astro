---
// One page per published post, pre-rendered at build time from the read-only API.
// What's on it is Transit411's own work: our rewritten headline, our paraphrase, the metadata we
// tagged, and a link out to the source. The source's article text is never reproduced here.
import Base from "../../layouts/Base.astro";
import PostItem from "../../components/PostItem.astro";
import { API_BASE, SECTIONS, getPosts, getRelated, getAgencies, getCig, matchAgency, cigProjectsFor }
  from "../../lib/content.js";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.filter((p) => p.slug).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const related = await getRelated(post, 6);

// ---- Explore: built from this article's tags + the agency reference table, at build time.
// No model calls, no client-side fetching: everything below is already known when the page is built.
const agencies = await getAgencies();
const cig = await getCig();
const agency = post.agencies.map((a) => matchAgency(a, agencies)).find(Boolean) || null;
const cigProjects = cigProjectsFor(agency, cig);
const cigProgram = post.programs.find((p) => p.startsWith("CIG")) || null;
const money = (n) => (n == null ? null : `$${Number(n).toLocaleString("en-US", { maximumFractionDigits: 0 })}M`);
const ask = (page, q) => `/${page}?q=${encodeURIComponent(q)}`;

const actions = [
  ...(agency && cigProjects.length
    ? [{ href: `/cig?agency=${encodeURIComponent(agency.name)}`,
         label: `See ${agency.name} in the CIG pipeline`,
         note: `${cigProjects.length} project${cigProjects.length === 1 ? "" : "s"} seeking funding` }]
    : []),
  ...(agency && agency.ntd_id
    ? [{ href: ask("ask-ntd", `${agency.name} ridership and cost per rider over the last five years`),
         label: `Ask NTD: ${agency.name} ridership & cost per rider`, note: "Opens the question, ready to run" }]
    : []),
  ...(cigProgram || cigProjects.length
    ? [{ href: ask("ask-cig", agency && cigProjects.length
           ? `What is the status of ${agency.name}'s CIG projects?`
           : `Which ${cigProgram} projects are furthest along?`),
         label: `Ask CIG about ${agency && cigProjects.length ? agency.name : cigProgram}`,
         note: "Opens the question, ready to run" }]
    : []),
];

// Reference links: only what the table actually has, plus the archived FTA profile for a matched project.
const profileFile = cigProjects.find((p) => p.profile_file)?.profile_file || null;
const refLinks = [
  ...(agency?.website ? [{ href: agency.website, label: `${agency.name} website` }] : []),
  ...(agency?.newsroom ? [{ href: agency.newsroom, label: `${agency.name} newsroom` }] : []),
  ...(agency?.procurement_url ? [{ href: agency.procurement_url, label: `${agency.name} procurement` }] : []),
  ...(profileFile ? [{ href: `${API_BASE}/api/cig/profile?file=${encodeURIComponent(profileFile)}`,
                       label: "FTA project profile (PDF)" }] : []),
  ...(post.url ? [{ href: post.url, label: `Original story at ${post.source || "the source"}` }] : []),
];
const showExplore = related.length > 0 || actions.length > 0 || refLinks.length > 0 || cigProjects.length > 0;
const pillarPath = Object.entries(SECTIONS).find(([, s]) => s.pillar === post.pillar)?.[0];
const canonical = new URL(`/article/${post.slug}`, Astro.site).href;
const description = (post.deck || post.title).slice(0, 300);
// Metadata chips. The section pages don't filter by facet yet, so these are labels for now; the
// pillar (above the headline) is the one link, and CIG programs point at the pipeline page.
const chips = [
  ...(post.state ? [{ label: post.state, href: null }] : []),
  ...post.agencies.map((a) => ({ label: a, href: null })),
  ...post.programs.map((p) => ({ label: p, href: p.startsWith("CIG") ? "/cig" : null })),
  ...post.mode.map((m) => ({ label: m, href: null })),
  ...post.tags.slice(0, 6).map((t) => ({ label: t, href: null })),
];
---
<Base title={`${post.title} — Transit411`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Transit411" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(post.image, Astro.site).href} />
    <meta name="twitter:image" content={new URL(post.image, Astro.site).href} />
    {post.publishedAt && <meta property="article:published_time" content={post.publishedAt} />}
    {post.pillar && <meta property="article:section" content={post.pillar} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={description} />
  </Fragment>

  <article class="wrap article">
    <div class="art-k">
      {pillarPath ? <a href={`/${pillarPath}`}>{post.pillar}</a> : post.pillar}
      {post.featured && <span class="post-flag">{post.sponsor ? `Featured · ${post.sponsor}` : "Featured"}</span>}
    </div>
    <div class="art-head">
      <div class="art-head-text">
        <h1 class="art-title disp">{post.title}</h1>
        {post.date && <div class="art-meta">{post.date}{post.source && <span> · Reported by {post.source}</span>}</div>}
      </div>
      {post.image && (
        <figure class="art-thumb">
          {post.imageIsHouse || !post.url
            ? <img src={post.image} alt={post.imageIsHouse ? `${post.pillar} — Transit411` : post.title} loading="lazy" />
            : <a href={post.url} target="_blank" rel="noopener noreferrer"><img src={post.image} alt={post.title} loading="lazy" /></a>}
          {!post.imageIsHouse && post.source && <figcaption>Image: {post.source}</figcaption>}
        </figure>
      )}
    </div>

    <div class="art-body">
      {post.paragraphs.length
        ? post.paragraphs.map((p) => <p>{p}</p>)
        : <p>{post.deck}</p>}
    </div>

    {post.url && (
      <a class="art-out" href={post.url} target="_blank" rel="noopener noreferrer">
        Read the full story at {post.source || "the source"} <span aria-hidden="true">→</span>
      </a>
    )}
    <p class="art-note">Transit411 summarizes and tags the story; the full reporting stays with the publisher.</p>

    {chips.length > 0 && (
      <div class="art-tags">
        {chips.map((c) => (c.href ? <a class="chip" href={c.href}>{c.label}</a> : <span class="chip">{c.label}</span>))}
      </div>
    )}

    {showExplore && (
      <section class="explore">
        <h2 class="section-h">Explore</h2>

        {related.length > 0 && (
          <div class="explore-block">
            <div class="explore-h">Related coverage</div>
            <div class="post-list">
              {related.map((p) => <PostItem post={p} size="compact" />)}
            </div>
          </div>
        )}

        {cigProjects.length > 0 && (
          <div class="explore-block">
            <div class="explore-h">{agency.name} in the CIG pipeline</div>
            <ul class="explore-cig">
              {cigProjects.slice(0, 4).map((p) => (
                <li>
                  <span class="explore-cig-n">{p.project_name}</span>
                  <span class="explore-cig-d">
                    {[p.phase === "Eng" ? "Engineering" : "Project Development", p.mode || "Unspecified",
                      money(p.cig_request_musd) && `${money(p.cig_request_musd)} sought`,
                      p.rating && `rated ${p.rating}`].filter(Boolean).join(" · ")}
                  </span>
                </li>
              ))}
            </ul>
            <p class="explore-note">From the FTA Capital Investment Grants dashboard of {cig?.summary?.snapshot}.</p>
          </div>
        )}

        {actions.length > 0 && (
          <div class="explore-block">
            <div class="explore-h">Go deeper</div>
            <div class="explore-actions">
              {actions.map((a) => (
                <a class="explore-action" href={a.href}>
                  <span class="explore-action-l">{a.label}</span>
                  <span class="explore-action-n">{a.note}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {refLinks.length > 0 && (
          <div class="explore-block">
            <div class="explore-h">Reference</div>
            <div class="explore-refs">
              {refLinks.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
            </div>
          </div>
        )}
      </section>
    )}
  </article>
</Base>
