---
import Base from "../layouts/Base.astro";
import PostItem from "../components/PostItem.astro";
import { getPosts, getCigSummary } from "../lib/content.js";

// Live content, fetched at build time (featured placements first, then newest).
const posts = await getPosts();
const [lead, ...rest] = posts;
const also = rest.slice(0, 3);
const wire = rest.slice(3, 11);

// CIG pipeline figures from the latest loaded dashboard; "—" if the API is unavailable.
const cig = await getCigSummary();
const snapLabel = cig?.snapshot
  ? new Date(cig.snapshot + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })
  : null;
const stats = [
  { l: "Active CIG projects", v: cig ? String(cig.projects) : "—", s: "In the FTA pipeline" },
  { l: "CIG requested", v: cig ? `$${(cig.total_cig_musd / 1000).toFixed(1)}B` : "—", s: "Total across the pipeline" },
  { l: "In Engineering", v: cig ? String(cig.by_phase?.Eng ?? 0) : "—", s: "Advanced past Project Development" },
];
---
<Base>
  {lead ? (
    <section class="lead-wrap wrap" style="padding-left:0;padding-right:0">
      <div class="lead">
        <span class="kicker">Lead &mdash; {lead.pillar}</span>
        <h1 class="disp">
          {lead.url ? <a href={lead.url} target="_blank" rel="noopener noreferrer" class="lead-link">{lead.title}</a> : lead.title}
        </h1>
        {lead.deck && <p class="deck">{lead.deck}</p>}
        <div class="byline">{[lead.date, lead.source && `Source: ${lead.source}`].filter(Boolean).join(" · ")}</div>
      </div>
      <div class="rail">
        <div class="rail-h">Also this week</div>
        {also.map((p) => <PostItem post={p} size="compact" />)}
        {also.length === 0 && <p class="rail-empty">More stories coming soon.</p>}
      </div>
    </section>
  ) : (
    <section class="wrap">
      <div class="empty empty-lead">
        <strong>No stories published yet.</strong>
        <span>The first funding, procurement, people and policy stories will appear here as they're published. <a href="#newsletter">Subscribe</a> to get them each week.</span>
      </div>
    </section>
  )}

  <section class="stats wrap" style="padding-left:0;padding-right:0">
    {stats.map((st) => (
      <div class="stat">
        <div class="l">{st.l}</div>
        <div class="v disp">{st.v}</div>
        <div class="s">{st.s}</div>
      </div>
    ))}
  </section>
  {snapLabel && <p class="wrap stats-note">From the FTA Capital Investment Grants dashboard of {snapLabel}.</p>}

  <div class="wrap">
    {wire.length > 0 && (
      <>
        <h2 class="section-h">More from the wire</h2>
        <div class="grid">
          {wire.map((p) => (
            <div class="cell">
              <div class="k">{p.pillar}</div>
              <h3>{p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}</h3>
            </div>
          ))}
        </div>
      </>
    )}

    <section id="newsletter" class="newsletter">
      <div>
        <h2 class="disp">Transit411 Weekly Intelligence</h2>
        <p>Funding news, procurement notices, and career moves &mdash; every Thursday.</p>
      </div>
      <form onsubmit="event.preventDefault();">
        <input type="email" placeholder="you@agency.gov" aria-label="Email address" />
        <button type="submit">Subscribe</button>
      </form>
    </section>
  </div>
</Base>
