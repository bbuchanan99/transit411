---
import Base from "../layouts/Base.astro";
import PostItem from "../components/PostItem.astro";
import { API_BASE, getPosts } from "../lib/content.js";

// Live content, fetched at build time (featured placements first, then newest).
const posts = await getPosts();
const [lead, ...rest] = posts;
const also = rest.slice(0, 3);
const wire = rest.slice(3, 11);

// The data-tools band under the lead. Replaces the old CIG stat band: three numbers said what the
// pipeline contained, this shows what you can ask it. Questions are data attributes so the markup
// and the typing loop can't drift apart.
const tools = [
  {
    id: "ntd", tag: "Ask NTD", href: "/ask-ntd",
    title: "Ridership, cost & finances",
    blurb: "Compare any U.S. agency — ridership, cost per rider, operating expense — just by asking.",
    questions: [
      "Which heavy-rail system is cheapest per rider?",
      "Compare BART and WMATA on ridership.",
      "Top 10 agencies by bus ridership in Texas.",
    ],
  },
  {
    id: "cig", tag: "Ask CIG", href: "/ask-cig",
    title: "The FTA funding pipeline",
    blurb: "Track every Capital Investment Grants project — phase, rating, and funding sought — in plain English.",
    questions: [
      "Which projects are seeking the most CIG funding?",
      "Show light-rail projects in the Engineering phase.",
      "Which projects advanced a phase this year?",
    ],
  },
];
---
<Base>
  {lead ? (
    <section class="lead-wrap wrap" style="padding-left:0;padding-right:0">
      <div class="lead">
        <span class="kicker">Lead &mdash; {lead.pillar}</span>
        <h1 class="disp">
          {lead.href
            ? <a href={lead.href} class="lead-link">{lead.title}</a>
            : lead.url ? <a href={lead.url} target="_blank" rel="noopener noreferrer" class="lead-link">{lead.title}</a> : lead.title}
        </h1>
        {lead.deck && <p class="deck">{lead.deck}</p>}
        <div class="byline">{[lead.date, lead.source && `Source: ${lead.source}`].filter(Boolean).join(" · ")}</div>
      </div>
      <div class="rail">
        <div class="rail-h">Also worth reading</div>
        {also.map((p) => <PostItem post={p} size="compact" />)}
        {also.length === 0 && <p class="rail-empty">More stories coming soon.</p>}
      </div>
    </section>
  ) : (
    <section class="wrap">
      <div class="empty empty-lead">
        <strong>No stories published yet.</strong>
        <span>The first funding, procurement, people and policy stories will appear here as they're published. <a href="#newsletter">Get The Wire</a>, our free newsletter, to have them emailed to you.</span>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap">
      <div class="band-h">Transit411 Data Tools</div>
      <h2 class="disp">Ask American transit's data in plain English</h2>
      <div class="tools">
        {tools.map((t) => (
          <div class="tool">
            <div class="tag">{t.tag}</div>
            <h3 class="disp">{t.title}</h3>
            <p>{t.blurb}</p>
            {/* The whole pill is the link. It carries a real href so it works before the script
                runs, on middle-click, and from the keyboard; the typing loop keeps that href
                pointed at whichever question is showing. */}
            <a class="ask-cell" href={`${t.href}?q=${encodeURIComponent(t.questions[0])}`}
               aria-label={t.tag} data-cell={t.id} data-base={t.href}
               data-questions={JSON.stringify(t.questions)}>
              <span class="q" data-q>{t.questions[0]}</span>
              <span class="caret" aria-hidden="true"></span>
              <span class="go" aria-hidden="true">Ask</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="wrap">
    {wire.length > 0 && (
      <>
        <h2 class="section-h">More from the wire</h2>
        <div class="grid">
          {wire.map((p) => (
            <div class="cell">
              <div class="k">{p.pillar}</div>
              <h3>{p.href
                ? <a href={p.href}>{p.title}</a>
                : p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}</h3>
            </div>
          ))}
        </div>
      </>
    )}

    {/* The newsletter. Kept well away from the data-tools band at the top of the page, and given
        an envelope-and-inbox identity of its own, so that signing up never reads as the way to
        get at the data tools. */}
    <section id="newsletter" class="newsletter">
      <div class="nl-copy">
        <div class="nl-kicker"><span class="nl-env" aria-hidden="true">&#9993;</span> The newsletter <span class="nl-free">Free</span></div>
        <h2 class="disp">The Wire &mdash; transit news in your inbox</h2>
        <p>Funding decisions, procurement notices and the people moving between agencies &mdash; emailed to you. Free, and one click to unsubscribe from any issue.</p>
      </div>
      <form id="subscribe-form" data-api={API_BASE}>
        <input type="email" name="email" required placeholder="Your email address" aria-label="Email address" />
        <button type="submit">Get The Wire</button>
      </form>
      <p class="nl-status" role="status" aria-live="polite"></p>
    </section>
  </div>
</Base>

<script>
  // Data-tools band: each cell types its example questions on a loop. No libraries, no layout
  // work per frame - one textContent write per tick - and it only ever touches its own two cells.
  //
  // The href is updated whenever the question changes, so the link is real: it works before this
  // script runs, on middle-click and from the keyboard, and it always points at the question the
  // reader can currently see. Clicking mid-word sends the WHOLE question rather than the prefix
  // typed so far, because a half-question pre-filled on the Ask page is of no use to anyone.
  const TYPE_MS = 85, ERASE_MS = 38, HOLD_MS = 2200, GAP_MS = 600, STAGGER_MS = 900;
  const cells = Array.from(document.querySelectorAll("[data-cell]"));
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  cells.forEach((cell, index) => {
    let questions;
    try { questions = JSON.parse(cell.dataset.questions); } catch { return; }
    if (!Array.isArray(questions) || !questions.length) return;
    const out = cell.querySelector("[data-q]");
    const base = cell.dataset.base;
    const setQuestion = (q) => { cell.href = base + "?q=" + encodeURIComponent(q); };

    // Someone who asked for less motion gets the first question, sitting still.
    if (still) {
      out.textContent = questions[0];
      setQuestion(questions[0]);
      const caret = cell.querySelector(".caret");
      if (caret) caret.style.animation = "none";
      return;
    }

    let at = 0, timer = null;
    const run = () => {
      const text = questions[at];
      setQuestion(text);                       // the link is the full question from the first keystroke
      let i = 0;
      timer = setInterval(() => {
        out.textContent = text.slice(0, ++i);
        if (i < text.length) return;
        clearInterval(timer);
        timer = setTimeout(() => {
          timer = setInterval(() => {
            out.textContent = text.slice(0, --i);
            if (i > 0) return;
            clearInterval(timer);
            at = (at + 1) % questions.length;
            timer = setTimeout(run, GAP_MS);
          }, ERASE_MS);
        }, HOLD_MS);
      }, TYPE_MS);
    };
    out.textContent = "";
    setTimeout(run, index * STAGGER_MS);       // so the two cards don't type in lockstep
  });
</script>

<script>
  // Newsletter signup -> POST /api/subscribe (the only public write). The address is stored as a
  // pending contact; the confirmation email comes later, so nobody is subscribed by this alone.
  const form = document.getElementById("subscribe-form");
  if (form) {
    // Someone who clicked "Subscribe" in the masthead arrives at #newsletter: put the cursor in the
    // box and flash the panel, so the click clearly did something.
    const focusSignup = () => {
      if (location.hash !== "#newsletter") return;
      const panel = document.getElementById("newsletter");
      panel?.classList.add("flash");
      setTimeout(() => panel?.classList.remove("flash"), 1400);
      form.email?.focus({ preventScroll: true });
    };
    window.addEventListener("hashchange", focusSignup);
    focusSignup();
    const status = document.querySelector(".nl-status");
    const btn = form.querySelector("button");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = form.email.value.trim();
      if (!email) return;
      btn.disabled = true;
      status.textContent = "Signing you up...";
      status.classList.remove("err");
      try {
        const r = await fetch(`${form.dataset.api}/api/subscribe`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, source: "site: homepage" }),
        });
        const d = await r.json().catch(() => ({}));
        if (r.ok) {
          form.reset();
          status.textContent = d.message || "Thanks — you're on the list.";
        } else {
          status.textContent = d.detail || "That didn't work. Please try again.";
          status.classList.add("err");
        }
      } catch {
        status.textContent = "Couldn't reach Transit411. Please try again in a moment.";
        status.classList.add("err");
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
