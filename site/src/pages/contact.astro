---
import Base from "../layouts/Base.astro";
---
<Base title="Contact — Transit411">
  <div class="page">
    <h1 class="disp">Contact</h1>
    <p class="lede">We'd love to hear from you — story tips, data questions, feedback, or partnership ideas.</p>

    <div class="contact-block">
      <div class="k">General</div>
      <p style="margin:4px 0 0"><a href="mailto:hello@transit411.net">hello@transit411.net</a></p>
    </div>
    <div class="contact-block">
      <div class="k">Advertising &amp; postings</div>
      <p style="margin:4px 0 0"><a href="mailto:advertise@transit411.net">advertise@transit411.net</a></p>
    </div>
    <div class="contact-block">
      <div class="k">Press &amp; data</div>
      <p style="margin:4px 0 0"><a href="mailto:press@transit411.net">press@transit411.net</a></p>
    </div>

    <h2 class="disp">Company</h2>
    <p>Transit411 is operated by <strong>Shepherd Labs, LLC</strong> &mdash; a data and AI studio focused on the transit industry.</p>
    <p class="meta">We aim to reply within two business days.</p>
  </div>
</Base>
