---
import Base from "../layouts/Base.astro";
import PostItem from "../components/PostItem.astro";
import { SECTIONS, getPosts } from "../lib/content.js";

export function getStaticPaths() {
  return Object.keys(SECTIONS).map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const meta = SECTIONS[section];
const posts = await getPosts(meta.pillar);
---
<Base title={meta.label + " — Transit411"}>
  <div class="wrap section-page">
    <h1 class="section-title disp">{meta.label}</h1>
    <p class="section-blurb">{meta.blurb}</p>
    <div class="post-list">
      {posts.map((p) => <PostItem post={p} />)}
      {posts.length === 0 && (
        <div class="empty">
          <strong>No {section === "news" ? "stories" : meta.label.toLowerCase() + " stories"} yet.</strong>
          <span>New items appear here as they're published. <a href="#newsletter">Subscribe</a> to get them each week.</span>
        </div>
      )}
    </div>
  </div>
</Base>
