---
// Public CIG Pipeline page. The pipeline as of the last build is embedded in the page (instant, and
// still works if the API is briefly down); the browser then checks the live API and re-renders if a
// newer dashboard has loaded. The table, milestones and snapshot history are the shared component
// bundle (static/t411.js, copied to /vendor at build time), the same code the Command Center runs.
import Base from "../layouts/Base.astro";
import { API_BASE, getCig, getCigChanges, getAgencies } from "../lib/content.js";

// name/alias -> the sponsor name on the dashboard, so /cig?agency=LA%20Metro (from an article's
// Explore module) filters to that agency's projects.
const sponsorByName = Object.fromEntries(
  (await getAgencies()).filter((a) => a.cig_sponsor).flatMap((a) =>
    [a.name, a.cig_sponsor, ...(a.aliases || [])].map((n) => [n.toLowerCase(), a.cig_sponsor])));
const cig = await getCig();
const changes = await getCigChanges();
const s = cig?.summary;
const snapLabel = s?.snapshot
  ? new Date(s.snapshot + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })
  : null;
const stats = [
  { l: "Projects", v: s ? String(s.projects) : "—", s: "Seeking CIG funding" },
  { l: "CIG requested", v: s ? `$${(s.total_cig_musd / 1000).toFixed(1)}B` : "—", s: "Across the pipeline" },
  { l: "Project Development", v: s ? String(s.by_phase?.PD ?? 0) : "—", s: "Phase: PD" },
  { l: "Engineering", v: s ? String(s.by_phase?.Eng ?? 0) : "—", s: "Phase: Eng" },
];
// Embedded as JSON; "<" escaped so no value can close the script tag.
const embedded = JSON.stringify(cig ?? null).replace(/</g, "\\u003c");
const embeddedChanges = JSON.stringify(changes ?? null).replace(/</g, "\\u003c");
---
<Base title="CIG Pipeline — Transit411">
  <Fragment slot="head">
    <link rel="stylesheet" href="/vendor/t411.css" />
    <script is:inline src="/vendor/t411.js"></script>
  </Fragment>

  <div class="wrap section-page">
    <h1 class="section-title disp">CIG Pipeline</h1>
    <p class="section-blurb">
      Every project in the FTA's Capital Investment Grants pipeline &mdash; New Starts, Small Starts and Core
      Capacity &mdash; with phase, cost, CIG funding sought, rating and expected grant timing. Click a project for
      its milestone dates and month-by-month history.
    </p>
  </div>

  <section class="stats wrap" style="padding-left:0;padding-right:0">
    {stats.map((st) => (
      <div class="stat">
        <div class="l">{st.l}</div>
        <div class="v disp" data-stat={st.l}>{st.v}</div>
        <div class="s">{st.s}</div>
      </div>
    ))}
  </section>
  <p class="wrap stats-note" id="cig-asof">
    {snapLabel ? `From the FTA Capital Investment Grants dashboard of ${snapLabel}.` : "The pipeline couldn't be loaded when this page was built."}
  </p>

  <div class="wrap cig-page">
    <h2 class="section-h cig-h">All projects</h2>
    <div class="cig-filters" role="group" aria-label="Filter by phase">
      <button type="button" class="cig-chip on" data-phase="">All phases</button>
      <button type="button" class="cig-chip" data-phase="PD">Project Development</button>
      <button type="button" class="cig-chip" data-phase="Eng">Engineering</button>
    </div>
    <div class="cig-filters" id="cig-modes" role="group" aria-label="Filter by mode"></div>
    <p id="cig-agency-note" class="cig-agency-note" hidden></p>
    <div id="cig-table" data-api={API_BASE}>
      <noscript><div class="empty"><strong>This table needs JavaScript.</strong></div></noscript>
    </div>
    <div id="cig-changes" class="cig-changes-below"></div>
    <p class="cig-source">
      Source: Federal Transit Administration, <a href="https://www.transit.dot.gov/CIG" target="_blank" rel="noopener noreferrer">Capital Investment Grants dashboard</a>.
      Dollar figures in millions. Ratings: H High, MH Medium-High, M Medium, ML Medium-Low, L Low.
    </p>
  </div>
  <script type="application/json" id="cig-sponsors" set:html={JSON.stringify(sponsorByName).replace(/</g, "\\u003c")}></script>
  <script type="application/json" id="cig-data" set:html={embedded}></script>
  <script type="application/json" id="cig-changes-data" set:html={embeddedChanges}></script>
</Base>

<script>
  // Runs after /vendor/t411.js (a classic script) has defined window.T411.
  const el = document.getElementById("cig-table");
  const api = el.dataset.api;
  let data = JSON.parse(document.getElementById("cig-data").textContent || "null");
  let phase = "";
  let mode = "";  // "" = all; "Unspecified" = FTA's sources don't state one
  // ?agency=<name or alias> or ?sponsor=<dashboard sponsor>: show just that agency's projects.
  const sponsors = JSON.parse(document.getElementById("cig-sponsors").textContent || "{}");
  const params = new URLSearchParams(location.search);
  const wanted = params.get("sponsor") || params.get("agency") || "";
  let sponsor = wanted ? (sponsors[wanted.toLowerCase()] || wanted) : "";
  const MODE_ORDER = ["BRT", "Light Rail", "Heavy Rail", "Commuter Rail", "Streetcar", "Unspecified"];
  const modeOf = (p) => p.mode || "Unspecified";

  // Mode chips with counts, only for modes in the current pipeline (Unspecified last).
  function renderModeChips() {
    const box = document.getElementById("cig-modes");
    const counts = {};
    ((data && data.projects) || []).forEach((p) => { counts[modeOf(p)] = (counts[modeOf(p)] || 0) + 1; });
    const keys = Object.keys(counts);
    if (keys.length < 2) { box.innerHTML = ""; return; }
    const order = MODE_ORDER.filter((m) => keys.includes(m)).concat(keys.filter((m) => !MODE_ORDER.includes(m)).sort());
    if (mode && !counts[mode]) mode = "";
    const esc = window.T411 ? window.T411.esc : (s) => s;
    box.innerHTML = `<button type="button" class="cig-chip${mode ? "" : " on"}" data-mode="">All modes</button>`
      + order.map((m) => `<button type="button" class="cig-chip${m === mode ? " on" : ""}" data-mode="${esc(m)}"`
        + (m === "Unspecified" ? ' title="FTA\'s dashboard and project profile don\'t state a mode"' : "")
        + `>${esc(m)} <span class="cig-chip-n">${counts[m]}</span></button>`).join("");
  }
  document.getElementById("cig-modes").addEventListener("click", (e) => {
    const b = e.target.closest("[data-mode]");
    if (!b) return;
    mode = b.dataset.mode;
    renderModeChips();
    render();
  });

  // Snapshot history comes from the public API, not a path on this site.
  const fetchHistory = (p) =>
    fetch(`${api}/api/cig/history?name=${encodeURIComponent(p.project_name)}&sponsor=${encodeURIComponent(p.sponsor || "")}`)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => d.history || []);

  // When an agency filter is on, say so and offer a way back to the whole pipeline.
  function renderAgencyNote(shown) {
    const note = document.getElementById("cig-agency-note");
    note.hidden = !sponsor;
    if (!sponsor) return;
    note.innerHTML = "";
    note.append(`Showing ${shown} project${shown === 1 ? "" : "s"} for ${wanted} — `);
    const b = document.createElement("button");
    b.type = "button";
    b.className = "cig-linkbtn";
    b.textContent = "show the whole pipeline";
    b.onclick = () => { sponsor = ""; renderModeChips(); render(); };
    note.append(b);
  }

  function render() {
    const T411 = window.T411;
    if (!T411) {
      el.innerHTML = '<div class="empty"><strong>The pipeline table couldn\'t load.</strong><span>Please refresh the page.</span></div>';
      return;
    }
    const all = (data && data.projects) || [];
    const rows = all.filter((p) => (!phase || p.phase === phase) && (!mode || modeOf(p) === mode)
      && (!sponsor || (p.sponsor || "").toLowerCase() === sponsor.toLowerCase()));
    T411.renderCigTable(el, rows, {
      fetchHistory,
      apiBase: api,  // FTA profile PDFs are served by the public API
      emptyText: all.length ? "No projects match these filters." : "The pipeline isn't available right now. Please check back soon.",
    });
    renderAgencyNote(rows.length);
  }

  function fmtStats(s) {
    const set = (k, v) => { const n = document.querySelector(`[data-stat="${k}"]`); if (n) n.textContent = v; };
    set("Projects", String(s.projects));
    set("CIG requested", `$${(s.total_cig_musd / 1000).toFixed(1)}B`);
    set("Project Development", String(s.by_phase?.PD ?? 0));
    set("Engineering", String(s.by_phase?.Eng ?? 0));
    const d = new Date(s.snapshot + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
    document.getElementById("cig-asof").textContent = `From the FTA Capital Investment Grants dashboard of ${d}.`;
  }

  function setPhase(p) {
    phase = p;
    document.querySelectorAll(".cig-chip[data-phase]").forEach((x) => x.classList.toggle("on", x.dataset.phase === p));
    render();
  }
  document.querySelectorAll(".cig-chip[data-phase]").forEach((b) => b.addEventListener("click", () => setPhase(b.dataset.phase)));

  // ---- What changed (shared component) ----
  const chEl = document.getElementById("cig-changes");
  let changes = JSON.parse(document.getElementById("cig-changes-data").textContent || "null");

  function openProject(name, sponsor) {
    if (window.T411.openCigProject(el, name, sponsor)) return;
    if (phase || mode) { mode = ""; renderModeChips(); setPhase(""); if (window.T411.openCigProject(el, name, sponsor)) return; }
    const note = chEl.querySelector(".cig-ch-note");
    if (note) note.textContent = `${name} is no longer in the pipeline, so it isn't in the table above.`;
  }

  function renderChanges() {
    const T411 = window.T411;
    if (!T411 || !changes) { chEl.innerHTML = ""; return; }
    const older = (changes.snapshots || []).filter((s) => changes.to && s < changes.to);
    const fmt = (s) => new Date(s + "T12:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    const sel = older.length > 1
      ? '<label class="cig-compare">Compare with <select id="cig-since">'
        + older.map((s, i) => `<option value="${T411.esc(s)}"${s === changes.from ? " selected" : ""}>${T411.esc(fmt(s))}${i === 0 ? " (previous)" : ""}</option>`).join("")
        + "</select></label>"
      : "";
    T411.renderCigChanges(chEl, changes, { headerExtra: sel, onProject: openProject });
    chEl.insertAdjacentHTML("beforeend", '<p class="cig-ch-note" aria-live="polite"></p>');
    const s = document.getElementById("cig-since");
    if (s) s.onchange = () => loadChanges(s.value);
  }

  function loadChanges(since) {
    return fetch(`${api}/api/cig/changes${since ? "?since=" + encodeURIComponent(since) : ""}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => { if (d && Array.isArray(d.snapshots)) { changes = d; renderChanges(); } })
      .catch(() => {});
  }

  renderModeChips();
  render();
  renderChanges();
  if (!changes) loadChanges();  // not in this build (e.g. API was down): fetch it live

  // Pick up a newer dashboard than the one this page was built with.
  fetch(`${api}/api/cig`)
    .then((r) => (r.ok ? r.json() : null))
    .then((live) => {
      if (!live?.summary?.projects || !Array.isArray(live.projects)) return;
      if (data?.summary?.snapshot === live.summary.snapshot && data.projects.length === live.projects.length) return;
      data = live;
      fmtStats(live.summary);
      renderModeChips();
      render();
      loadChanges();  // a newer dashboard means newer changes too
    })
    .catch(() => {});
</script>
