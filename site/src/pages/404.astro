---
// Cloudflare Pages serves this (as 404.html, with a 404 status) for any unknown address.
import Base from "../layouts/Base.astro";
import { SECTIONS } from "../lib/content.js";
---
<Base title="Page not found — Transit411">
  <div class="wrap section-page">
    <h1 class="section-title disp">Page not found</h1>
    <p class="section-blurb">We couldn't find that page. It may have moved, or the link may be mistyped.</p>
    <div class="empty">
      <strong>Try one of these instead</strong>
      <span>
        <a href="/">Home</a>
        {Object.entries(SECTIONS).map(([slug, s]) => <> &middot; <a href={`/${slug}`}>{s.label}</a></>)}
        &middot; <a href="/data">Data</a>
      </span>
    </div>
  </div>
</Base>
