---
import "../styles/dispatch.css";
const { title = "Transit411 — Transit funding, procurement & talent" } = Astro.props;
const sections = ["News", "Funding", "Procurement", "People", "Policy", "Data"];
const today = new Date().toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content="Independent coverage of transit funding, procurement, and the people moving public transportation — plus data tools over the National Transit Database and the FTA CIG pipeline." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Spectral:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" />
</head>
<body>
  <div class="wire-ticker">
    <span class="wire-label">Wire</span>
    <span>Preview build — the live funding &amp; procurement wire connects when the API goes online</span>
  </div>
  <div class="dateline">
    <span>{today} &middot; Weekly Intelligence</span>
    <span><a href="#newsletter">Subscribe free</a></span>
  </div>
  <header class="mast">
    <a href="/" class="brand">TRANSIT<span>411</span></a>
    <nav class="mast-nav">
      {sections.map((s) => <a href={"/" + s.toLowerCase()}>{s}</a>)}
      <a class="subscribe-btn" href="#newsletter">Subscribe</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="foot">
    <div>
      <div class="brand foot-brand disp">TRANSIT<span>411</span></div>
      <div class="foot-tag">Independent transit funding &amp; talent coverage</div>
    </div>
    <nav class="foot-cols">
      <div><span class="foot-h">Sections</span><a href="/news">News</a><a href="/funding">Funding</a><a href="/data">Data</a></div>
      <div><span class="foot-h">Advertise</span><a href="#">Post a job</a><a href="#">Post a solicitation</a></div>
      <div><span class="foot-h">Transit411</span><a href="#">About</a><a href="#">Contact</a></div>
    </nav>
  </footer>
</body>
</html>
