---
// One published post in a list. `post` comes from getPosts() in src/lib/content.js.
// The headline goes to the post's own page (/article/<slug>), where the summary, the metadata and
// the Explore module live; the link out to the source sits there. A small "source" link stays here
// for readers who only want the original. A post with no slug falls back to the source link.
const { post, size = "full" } = Astro.props;
const meta = [post.date, post.source].filter(Boolean).join(" · ");
const chips = [...(post.state ? [post.state] : []), ...post.agencies].slice(0, 5);
---
<article class={`post post-${size}`}>
  {size === "full" && post.image && post.href && (
    <a class="post-thumb" href={post.href} aria-hidden="true" tabindex="-1">
      <img src={post.image} alt="" loading="lazy" />
    </a>
  )}
  <div class="post-k">
    {post.pillar}
    {post.featured && <span class="post-flag">{post.sponsor ? `Featured · ${post.sponsor}` : "Featured"}</span>}
  </div>
  <h2 class="post-title">
    {post.href
      ? <a href={post.href}>{post.title}</a>
      : post.url
        ? <a href={post.url} target="_blank" rel="noopener noreferrer">{post.title}</a>
        : post.title}
  </h2>
  {size === "full" && post.deck && <p class="post-deck">{post.deck}</p>}
  {(meta || chips.length > 0) && (
    <div class="post-meta">
      {meta && <span>{meta}</span>}
      {post.href && post.url && (
        <a class="post-src" href={post.url} target="_blank" rel="noopener noreferrer">source ↗</a>
      )}
      {size === "full" && chips.map((c) => <span class="chip">{c}</span>)}
    </div>
  )}
</article>
