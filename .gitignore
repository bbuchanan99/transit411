# Secrets: the real .env holds ANTHROPIC_API_KEY. Only .env.example is committed.
.env
.env.*
!.env.example

# Built data (rebuild with: docker compose run --rm ingest)
*.duckdb
*.duckdb.wal
# Anchored: a bare "data/" matches a directory of that name at ANY depth, and it silently
# swallowed site/src/data - the NTD snapshot the public data pages are built from - so the site
# built locally and failed on Cloudflare with an unresolvable import.
/data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Claude Code: the launch config is shared (it starts the site preview); local
# permission state is not.
.claude/settings.local.json
