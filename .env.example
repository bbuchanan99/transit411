# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
DATA_DIR=/share/Container/transit411/data
# Model that turns questions into SQL. claude-haiku-4-5 is cheapest; claude-sonnet-5 is more reliable
# on multi-step questions (trends across agencies, year-over-year comparisons).
ASK_NTD_MODEL=claude-haiku-4-5
# Daily collector run time (24h) and time zone. Turn the daily run on/off from the Command Center.
COLLECT_AT=06:00
COLLECT_TZ=America/New_York
# Postgres password for the content store. Generate one with: openssl rand -hex 16
DB_PASSWORD=change-me

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
# Cloudflare Pages deploy hook (Pages project -> Settings -> Builds -> Deploy hooks). Secret: anyone with
# it can trigger builds. Publishing/unpublishing in the Command Center calls it to rebuild the site.
CF_PAGES_DEPLOY_HOOK=
# Public "ask" endpoints (each question is an Anthropic call on your account): on/off and limits.
PUBLIC_ASK_ENABLED=true
ASK_PER_IP_HOUR=20
ASK_PER_DAY=200
ASK_MAX_CHARS=500
