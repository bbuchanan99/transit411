# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
DATA_DIR=/share/Container/transit411/data
# Model that turns questions into SQL. claude-haiku-4-5 is cheapest; claude-sonnet-5 is more reliable
# on multi-step questions (trends across agencies, year-over-year comparisons).
ASK_NTD_MODEL=claude-haiku-4-5
# Model for the Collection tab's Recommend button (editorial triage of the review queue).
RECOMMEND_MODEL=claude-haiku-4-5
# Daily collector run time (24h) and time zone. Turn the daily run on/off from the Command Center.
COLLECT_AT=06:00
COLLECT_TZ=America/New_York
# Postgres password for the content store. Generate one with: openssl rand -hex 16
DB_PASSWORD=change-me

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
# Cloudflare Pages deploy hook (Pages project -> Settings -> Builds -> Deploy hooks). Secret: anyone with
# it can trigger builds. Publishing/unpublishing in the Command Center calls it to rebuild the site.
CF_PAGES_DEPLOY_HOOK=
# Public "ask" endpoints (each question is an Anthropic call on your account): on/off and limits.
PUBLIC_ASK_ENABLED=true
ASK_PER_IP_HOUR=20
ASK_PER_DAY=200
ASK_MAX_CHARS=500

# ---- Email (Amazon SES sends; the contact list lives in our Postgres) ----
# IAM user limited to ses:SendRawEmail. Fill these in on the NAS only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must be the verified identity / subdomain, e.g. "Transit411 <news@mail.transit411.net>"
SES_FROM=
SES_REPLY_TO=hello@transit411.net
# Optional SES configuration set (event publishing); leave blank if you haven't made one.
SES_CONFIGURATION_SET=
# Sends per second. The SES sandbox allows 1/s; raise it once production access is granted.
SES_MAX_PER_SECOND=1
# Only notifications from this SNS topic are accepted (leave blank to accept any verified SNS message).
SNS_TOPIC_ARN=
# Where confirm/unsubscribe links point (must be publicly reachable through the tunnel).
EMAIL_LINK_BASE=https://api.transit411.net
PUBLIC_SITE_URL=https://transit411.net
# Public signup limits (no model cost, but keep the form from being flooded).
SUBSCRIBE_PER_IP_HOUR=5
SUBSCRIBE_PER_DAY=500
