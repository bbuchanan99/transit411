# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
DATA_DIR=/share/Container/transit411/data
# Model that turns questions into SQL. claude-haiku-4-5 is cheapest; claude-sonnet-5 is more reliable
# on multi-step questions (trends across agencies, year-over-year comparisons).
ASK_NTD_MODEL=claude-haiku-4-5
# Postgres password for the content store. Generate one with: openssl rand -hex 16
DB_PASSWORD=change-me
